{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
  {
    "source": "/assets/hero-community.webp",
    "destination": "/circlefound-final-launch%20(1)/assets/hero-community.webp"
  },
  {
    "source": "/assets/park-community.webp",
    "destination": "/circlefound-final-launch%20(1)/assets/park-community.webp"
  },
  {
    "source": "/assets/game-night-community.webp",
    "destination": "/circlefound-final-launch%20(1)/assets/game-night-community.webp"
  }
],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; connect-src 'self' https://rqzhtyvcuaninydabjma.supabase.co https://vitals.vercel-insights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://book.stripe.com"
        }
      ]
    }
  ]
}
